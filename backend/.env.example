# ===================================================================
# SENTORA BACKEND ENVIRONMENT VARIABLES
# ===================================================================

# Port to listen on (automatically assigned by Render / Railway in cloud)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# -------------------------------------------------------------------
# Google Gemini API Key
# -------------------------------------------------------------------
# Obtain a FREE API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
#
# NOTE: Sentora does NOT require Ollama or heavy local LLM software!
# If this key is blank, Sentora will automatically run in intelligent
# offline fallback mode with built-in heuristic NLP classification.
GEMINI_API_KEY=

# Gemini Model identifier (Defaults to fast, lightweight gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# -------------------------------------------------------------------
# CORS Configuration
# -------------------------------------------------------------------
# Set to '*' to allow all origins, or comma-separated origins:
# e.g., https://sentora.vercel.app,https://mysentora.com
CORS_ORIGIN=*
